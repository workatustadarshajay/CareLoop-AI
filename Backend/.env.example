DATABASE_URL=postgresql+asyncpg://careloop:careloop@localhost:5432/careloop
# Which LLM to use: gemini (default), anthropic, or openai.
LLM_PROVIDER=gemini
GEMINI_API_KEY=paste-your-api-key-here
# Or use GOOGLE_API_KEY instead of GEMINI_API_KEY.
GEMINI_MODEL=gemini-3.8-flash
ANTHROPIC_API_KEY=paste-your-anthropic-key-here
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=paste-your-openai-key-here
OPENAI_MODEL=gpt-5
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Days ahead a card's due date triggers a patient reminder (default 3).
REMINDER_DAYS=3
