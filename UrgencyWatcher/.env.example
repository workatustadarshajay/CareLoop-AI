DATABASE_URL=postgresql://careloop:careloop@localhost:5432/careloop
WATCH_DIR=inbox
POLL_SECONDS=10
# Only needed behind a TLS-inspecting proxy, so model downloads trust the system certificates.
SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
# Set to 1 if downloads fail with "Basic Constraints of CA cert not marked critical".
RELAX_X509_STRICT=1
