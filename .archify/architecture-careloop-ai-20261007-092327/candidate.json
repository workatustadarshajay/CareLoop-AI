  "cards": [
    {
      "dot": "cyan",
      "title": "Note becomes a plan",
      "items": [
        "POST /api/notes/process saves the note and its cards in one transaction",
        "One save_card call per item; five card types, never a combined card",
        "A follow-up note closes the matching card and stores the confirming phrase"
      ]
    },
    {
      "dot": "emerald",
      "title": "Care gaps and risk",
      "items": [
        "28 diagnoses in the checklist; coverage is tested by a second model call",
        "Doctors approve every flag: Add as card or Dismiss",
        "Dependents turn at_risk while a blocker is open, and heal when it closes"
      ]
    },
    {
      "dot": "violet",
      "title": "Agent surface",
      "items": [
        "The MCP server is a pure REST client and holds no database credentials",
        "list_patients, list_cards, get_card, close_card, flag_card_risk, list_notes"
      ]
    },
    {
      "dot": "amber",
      "title": "Triage sidecar",
      "items": [
        "UrgencyWatcher polls a folder every 10 s and archives handled files",
        "laya routes each message to urgent, medium or not_urgent in urgency.messages"
      ]
    }
  ]
